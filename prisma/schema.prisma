generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          String   @id @default(cuid())
  orderId     String   @unique

  // identity
  fullName          String
  nickname          String
  email             String
  phone             String
  domisili          String            @default("")
  participantStatus String            // Student / Fresh Graduate / Professional
  studentId         String?
  university        String?
  faculty           String?
  facultyOther      String?
  institution       String?
  major             String?

  // persona (long-answer -> quick choice)
  tedFamiliarity    String
  topics            String[] @default([])
  musicLifestyle    Boolean  @default(false)
  environmentShapes Boolean  @default(false)
  artsExpression    Boolean  @default(false)
  eventAspect       String[] @default([])
  eventAspectOther  String?

  // consent
  consentAccurate       Boolean @default(false)
  consentDataProcessing Boolean @default(false)
  consentUpdates        Boolean @default(false)

  // ticket & payment
  tier        String
  price       String
  paymentName String?
  proofUrl    String?
  status      TicketStatus @default(PENDING)
  qrToken     String       @unique @default(cuid())
  scanned     Boolean      @default(false)
  scannedAt   DateTime?
  createdAt   DateTime     @default(now())
}

enum TicketStatus {
  PENDING
  CONFIRMED
  REJECTED
}
